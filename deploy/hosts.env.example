# Deployment targets for deploy/deploy.sh.
#
# Copy this to `hosts.env` (same directory) and fill in the real values.
# `hosts.env` is gitignored, so real host addresses, panel paths and key paths
# never enter the repository — the repo is public.
#
#   cp deploy/hosts.env.example deploy/hosts.env
#   $EDITOR deploy/hosts.env
#
# Every value below is required. Read by deploy/deploy.sh only.

# SSH access to the primary host. This host is also the jump host for the
# secondary one, because it holds the key the secondary trusts.
#   PRIMARY_HOST   hostname or IP
#   PRIMARY_SSH_KEY  path to the private key on the operator's machine
#   PRIMARY_BASE   URL of the panel as the host sees it (health gate target)
#   PRIMARY_ORIGIN scheme://host[:port] the panel is served on
#   PRIMARY_CURL_EXTRA extra curl args to reach that origin (may be empty)
PRIMARY_HOST="203.0.113.10"
PRIMARY_SSH_KEY="$HOME/.ssh/deploy_key"
PRIMARY_BASE="https://panel.example.com/admin/"
PRIMARY_ORIGIN="https://panel.example.com"
PRIMARY_CURL_EXTRA="--resolve panel.example.com:443:127.0.0.1"
# Path segment (relative to the origin) where the built assets are served.
# Used to fetch each asset the embedded HTML references.
PRIMARY_ASSET_DIR="admin/assets/"

# The secondary host, reached through the primary as a jump host.
#   SECONDARY_JUMP_KEY  path to the key ON the primary host, used for the hop
SECONDARY_HOST="203.0.113.20"
SECONDARY_JUMP_KEY="/root/.ssh/relay_key"
SECONDARY_BASE="http://127.0.0.1:2053/panel-random-path/"
SECONDARY_ORIGIN="http://127.0.0.1:2053"
SECONDARY_ASSET_DIR="panel-random-path/assets/"

# Which hosts `--hosts both` means, in order. Primary first, so a failure there
# is discovered before the secondary is touched.
DEPLOY_ORDER="primary secondary"

# Ignore editor and IDE settings
.idea/
.vscode/
.cursor/
.specify/
.claude/
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz

# Ignore build and distribution directories
backup/
bin/
x-ui/
dist/
release/
node_modules/

# Ignore compiled binaries
main
3x-ui

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
x-ui.db
x-ui.db-shm
x-ui.db-wal
system_metrics.gob
*.dump

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env

# Ignore the deployment target configuration: real host addresses, panel paths
# and SSH key paths live here and must not be committed. The template
# (deploy/hosts.env.example) is committed instead. See deploy/PRODUCTION.md.
deploy/hosts.env
